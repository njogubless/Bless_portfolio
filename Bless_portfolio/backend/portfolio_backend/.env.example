# Copy this file to `.env` for local development:
#   cp .env.example .env
#
# In CI and production (Render), set these as real platform environment
# variables instead — .env is gitignored and must never hold real secrets.

# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-with-a-long-random-string

# Must be False in any environment reachable from the internet.
DEBUG=True

# Leave empty to use local SQLite. Set to a postgres:// URL to match production.
DATABASE_URL=

# Comma-separated extras merged into the defaults already baked into
# settings.py — only needed for a domain that isn't already listed there
# (e.g. a staging environment).
ALLOWED_HOSTS=
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# Gmail SMTP, used to email a notification when the contact form is
# submitted. Use a Google "App Password", never your real account password:
# https://myaccount.google.com/apppasswords
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
# Inbox that contact-form notifications land in. Defaults to EMAIL_HOST_USER
# if left empty.
CONTACT_NOTIFICATION_EMAIL=

# Opt-in production security headers — see settings.py for why these
# default off even when DEBUG=False.
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
